{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper-c-sta-specialist-output-v2",
  "title": "Calibrated specialist vote with non-semantic abstention",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vote_id",
    "sample_id",
    "family_id",
    "specialist_category",
    "backbone_key",
    "seed",
    "target_backbone_key",
    "qualified",
    "abstain",
    "probabilities",
    "calibration_id",
    "candidate",
    "candidate_sha256"
  ],
  "properties": {
    "vote_id": {"type": "string", "minLength": 1},
    "sample_id": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "specialist_category": {
      "description": "The specialist's registered focal category.",
      "$ref": "#/$defs/coreCategory"
    },
    "backbone_key": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 1},
    "target_backbone_key": {"type": "string", "minLength": 1},
    "qualified": {"type": "boolean"},
    "abstain": {
      "type": "boolean",
      "description": "Eligibility state only; true never means semantic REVIEW."
    },
    "probabilities": {"$ref": "#/$defs/probabilities"},
    "calibration_id": {"type": "string", "minLength": 1},
    "candidate": {
      "oneOf": [
        {"$ref": "#/$defs/candidate"},
        {"type": "null"}
      ]
    },
    "candidate_sha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coreCategory": {
      "enum": [
        "toxicity_abuse",
        "jailbreak_evasion",
        "prompt_injection_exfiltration",
        "mortgage_fair_lending",
        "mortgage_closed_end_advertising"
      ]
    },
    "probabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow", "review", "intervene"],
      "properties": {
        "allow": {"type": "number", "minimum": 0, "maximum": 1},
        "review": {"type": "number", "minimum": 0, "maximum": 1},
        "intervene": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "category",
        "violation_tags",
        "policy_ids",
        "confidence",
        "confidence_source"
      ],
      "properties": {
        "action": {"enum": ["allow", "review", "intervene"]},
        "category": {"$ref": "#/$defs/coreCategory"},
        "violation_tags": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "policy_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence_source": {"const": "calibrated_action_distribution"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"qualified": {"const": false}},
        "required": ["qualified"]
      },
      "then": {
        "properties": {"abstain": {"const": true}}
      }
    },
    {
      "if": {
        "properties": {"abstain": {"const": true}},
        "required": ["abstain"]
      },
      "then": {
        "properties": {
          "candidate": {"type": "null"},
          "candidate_sha256": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "candidate": {"$ref": "#/$defs/candidate"},
          "candidate_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  ]
}
