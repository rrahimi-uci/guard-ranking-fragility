/data/
# Raw third-party row text (ToxicChat CC-BY-NC, gated AI2, etc.) stays local.
# Text-free release artifacts are written separately to public_manifests/.
/artifacts/**/manifests/*.jsonl
# Env / secrets
.env
.env.local
# OS / editor
.DS_Store
.idea/
.vscode/
# Paper A: raw third-party rows (NC-licensed) and large run artifacts — not redistributed in-repo
artifacts/paper_a_sft/manifests/
artifacts/paper_a_sft/scores/
artifacts/paper_a_sft/runs/
artifacts/paper_a_sft/base_scores/
artifacts/paper_a_sft/calibration/
!artifacts/paper_a_sft/public_manifests/
!artifacts/paper_a_sft/public_manifests/**
# Corrected v2 namespace: keep raw/manifold-heavy artifacts local. Text-free
# public_manifests/, audit summaries, locks, and analysis outputs remain releasable.
artifacts/paper_a_sft_v2/manifests/
/artifacts/paper_a_sft_v2/scores/*
!/artifacts/paper_a_sft_v2/scores/scores.parquet
!/artifacts/paper_a_sft_v2/scores/metadata.json
artifacts/paper_a_sft_v2/runs/
artifacts/paper_a_sft_v2/base_scores/
artifacts/paper_a_sft_v2/calibration/
artifacts/paper_a_sft_v2/smoke/
# Archived explorer prompt samples may contain NC-licensed or gated text.
# reproduce.py build intermediate (canonical copy is committed under papers/unified-report/generated/)
mortgage-benchmark/generated/
# adaptation study: large binaries (LoRA adapters, model caches) stay in GCS only; text-free
# score parquets + analysis + preflight reports ARE committed for future reference (Paper A pattern).
artifacts/starting_type_adaptation_v1/runs/
artifacts/starting_type_adaptation_v1/starting_scores/
artifacts/starting_type_adaptation_v1/smoke/
artifacts/starting_type_adaptation_v1/downloads/
artifacts/starting_type_adaptation_v1/manifests/
/artifacts/starting_type_adaptation_v1/scores/*
!/artifacts/starting_type_adaptation_v1/scores/*.parquet
!/artifacts/starting_type_adaptation_v1/scores/*.metadata.json
# KL-SFT (Act I control): keep text-free score parquets committed; adapters stay in GCS.
artifacts/klsft_v1/runs/
artifacts/klsft_v1/adapters/
artifacts/starting_type_adaptation_v1/scores/combined.parquet

# Paper C v2: local model weights, reference logits, development scores, and
# inventories are hash-bound by LOCK.json but are not committed as source.
/artifacts/paper_c_dpo_v2/stage1/
/artifacts/paper_c_dpo_v2/splits/
/artifacts/paper_c_dpo_v2/reference/
/artifacts/paper_c_dpo_v2/selections/
/artifacts/paper_c_dpo_v2/runs/
/artifacts/paper_c_dpo_v2/scores/*
!/artifacts/paper_c_dpo_v2/scores/retrospective/
!/artifacts/paper_c_dpo_v2/scores/prospective/
/artifacts/paper_c_dpo_v2/scores/retrospective/*
!/artifacts/paper_c_dpo_v2/scores/retrospective/scores.parquet
!/artifacts/paper_c_dpo_v2/scores/retrospective/metadata.json
/artifacts/paper_c_dpo_v2/scores/prospective/*
!/artifacts/paper_c_dpo_v2/scores/prospective/scores.parquet
!/artifacts/paper_c_dpo_v2/scores/prospective/metadata.json
/artifacts/paper_c_dpo_v2/provenance/
/artifacts/paper_c_dpo_v2/smoke/

# benchmark-explorer: withdrawn, superseded by apps/benchmark-explorer/.
# This rule used to read "Commit index.public.html (public + synthetic only)" — that
# instruction is what produced a tracked, pushed 55 MB blob carrying all 2,000 rows of a
# dataset whose license is NOT_SELECTED. "Public + synthetic" was asserted per file, not
# derived per source, so it was wrong the moment a source was added. Licensing decisions
# now live in benchmarks/registry/distribution.yaml and are applied by a build that fails
# closed; nothing bulk under benchmark-explorer/ is committable.
benchmark-explorer/*.html
benchmark-explorer/*.withdrawn-local
apps/benchmark-explorer/dist/

# Office editor lock files are not publication artifacts
~$*
# PowerPoint writes "<name> - Repaired.pptx" when it recovers or re-saves a deck. Those
# are hand-edited copies of a code-generated artifact (papers/unified-report/slides/README.md
# explains why they get deleted rather than kept), and nothing matched them before, so a
# `git add -A` would have published one.
*Repaired.pptx
*Repaired.docx
*Repaired.xlsx

# Transient execution outputs (storage contract: runs/<study_id>/<run_id>/)
/runs/

# Explorer build roots are fully ignored: dist/public is audited allowlist-only
# staging, dist/local is gated full-data output. The pre-existing global `dist/` rule
# already covers them; the build creates both. Never a tracked Git blob.
