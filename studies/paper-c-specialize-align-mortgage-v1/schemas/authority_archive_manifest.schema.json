{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper-c-sta-authority-archive-manifest-v1",
  "title": "Mortgage authority-byte archive and excerpt bindings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "archive_id",
    "snapshot_id",
    "snapshot_object_sha256",
    "authority_sources",
    "authorized_excerpts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "archive_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "snapshot_object_sha256": {"$ref": "#/$defs/sha256"},
    "authority_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority_id", "archived_path", "archived_sha256"],
        "properties": {
          "authority_id": {"type": "string", "minLength": 1},
          "archived_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.).+"},
          "archived_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "authorized_excerpts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content_sha256", "authority_ids"],
        "properties": {
          "content_sha256": {"$ref": "#/$defs/sha256"},
          "authority_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
